---
# =============================================================================
# SECRETS TEMPLATE — Kopiere diese Datei nach secrets.yml und fülle sie aus.
# secrets.yml ist in .gitignore und wird NIEMALS ins Repository eingecheckt!
# =============================================================================
#
#   cp group_vars/secrets.yml.example group_vars/secrets.yml
#   # Dann secrets.yml editieren und echte Werte eintragen.
#
# Optional: mit Ansible Vault verschlüsseln:
#   ansible-vault encrypt group_vars/secrets.yml
#   ansible-vault edit   group_vars/secrets.yml
#
# =============================================================================

# ---------------- WebLogic Admin Credentials ---------------------------------
vault_weblogic_admin_user: "admin"
vault_weblogic_admin_password: "CHANGEME_WL_PASSWORD"

# ---------------- Harbor Registry --------------------------------------------
# Vollständiger Hostname deiner Harbor-Instanz (ohne https://)
vault_harbor_registry: "harbor.CHANGEME.example.com"

# Harbor-Projekt in dem die Images liegen
vault_harbor_project: "weblogic"

# Harbor-Login-Credentials (für docker login / imagePullSecret)
vault_harbor_user: "CHANGEME_HARBOR_USER"
vault_harbor_password: "CHANGEME_HARBOR_PASSWORD"

# ---------------- Image-URLs (nach Harbor-Upload) ----------------------------
# WebLogic Image (für Ansible-Tasks genutzt)
# Beispiel: harbor.example.com/weblogic/wls:14.1.1.0-jdk17
vault_weblogic_image: "{{ vault_harbor_registry }}/{{ vault_harbor_project }}/wls:14.1.1.0-jdk17"

# HINWEIS: postgres/testdb-Image wird NICHT hier gesetzt!
# → Stattdessen in k8s/overlays/manual/kustomization.yaml unter images: eintragen.
# Das Script harbor_push_image.sh gibt den fertigen Snippet am Ende aus.

