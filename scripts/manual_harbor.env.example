# Copy to scripts/manual_harbor.env and adjust values for your cluster.
# This file is sourced by scripts/deploy_manual_harbor.sh

# Namespace used for manual WebLogic workloads
NAMESPACE=wl

# kubectl command with optional context
KC_CMD='kubectl --context <dein-context>'

# Allowed registry image for deny-foreign-registries clusters
WLS_IMAGE='harbor.example.com/<projekt>/wls-dev:1.3'

