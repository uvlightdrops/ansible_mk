# Copy to scripts/manual_harbor.env and adjust values for your cluster.
# This file is sourced by scripts/deploy_manual_harbor.sh

# Namespace used for manual WebLogic workloads
NAMESPACE=wl

# kubectl command with optional context
KC_CMD='kubectl --context <dein-context>'

# Allowed registry image for deny-foreign-registries clusters
WLS_IMAGE='harbor.example.com/<projekt>/wls-dev:1.3'

# Image tag inside the docker save archive
SOURCE_IMAGE='wls-dev:1.3'

# docker-archive tar used by scripts/push_to_harbor.sh (skopeo copy)
IMAGE_TAR='/media/<user>/<usb>/wls-dev_manual_1.3.tar'

# Optional: override test DB image as well (if docker.io is blocked)
DB_IMAGE='harbor.example.com/<projekt>/postgres:15'

# Optional: skopeo destination credentials in user:pass form
# DEST_CREDS='<user>:<pass>'

