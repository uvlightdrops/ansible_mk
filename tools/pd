#!/usr/bin/env bash
set -euo pipefail

# Primary wrapper to call the shell orchestrator.
# Usage: pd <command> [global options] [command options]

# Resolve repo root (assume tools/ is at repo root)
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

CLI_PATH="$REPO_ROOT/prepare_docker/pd.sh"

if [ ! -f "$CLI_PATH" ]; then
  echo "prepare_docker shell CLI not found at $CLI_PATH" >&2
  exit 2
fi

exec "$CLI_PATH" "$@"

